# ─── AWS Core ─────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Note: App Runner uses an IAM instance role — do NOT set access keys here in production.
# For local dev only:
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here

# ─── DynamoDB (Prompt 1) ──────────────────────────────────────────────────────
DYNAMODB_TABLE=bharatmedia-dev

# ─── S3 Images (Prompt 2) ─────────────────────────────────────────────────────
S3_BUCKET_NAME=bharatmedia-images-dev

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (set in App Runner console):
# ALLOWED_ORIGINS=https://your-app.amplifyapp.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

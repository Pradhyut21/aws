# ─── API Connection ───────────────────────────────────────────────────────────
# Local dev (default — no changes needed):
# VITE_API_URL=http://localhost:4000/api
# VITE_WS_URL=ws://localhost:4000

# Production (set these in Amplify console → App settings → Environment variables):
VITE_API_URL=https://your-apprunner-service-url.awsapprunner.com/api
VITE_WS_URL=wss://your-apprunner-service-url.awsapprunner.com
